{
  "realm": "mcp-lab",
  "displayName": "MCP lab (Thread 04-B, Topics 4A-5)",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "clients": [
    {
      "clientId": "news-cli",
      "name": "News CLI (public client, authorization code + PKCE)",
      "description": "Native-style public client for T4A exercises: no secret, loopback redirect, S256 PKCE enforced, password and implicit grants off.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:8765/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "audience-news-mcp-server",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "news-mcp-server",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "audience-billing-mcp-server",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "billing-mcp-server",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "news-mcp-server",
      "name": "News MCP server (resource server)",
      "description": "The protected resource. No login flows; authenticates only to call token introspection. Secret is generated by Keycloak and moved to Vault.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "resource_url": "http://localhost:8001/mcp"
      }
    },
    {
      "clientId": "billing-mcp-server",
      "name": "Billing MCP server (second resource, for the audience exercise)",
      "description": "A second resource so T4A C3 can show a token minted for billing being rejected by the news server.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "resource_url": "http://localhost:8002/mcp"
      }
    }
  ],
  "users": [
    {
      "username": "srini-test",
      "enabled": true,
      "email": "srini-test@mcp-lab.local",
      "emailVerified": true,
      "firstName": "Srini",
      "lastName": "Test"
    }
  ]
}